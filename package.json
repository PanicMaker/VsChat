{
  "name": "vschat",
  "displayName": "VsChat",
  "description": "Chat through WeChat iLink or QQ Bot directly in VSCode",
  "version": "0.9.0",
  "publisher": "PanicMaker",
  "repository": {
    "type": "git",
    "url": "https://github.com/PanicMaker/VsChat.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vschat",
          "title": "VsChat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "vschat": [
        {
          "type": "webview",
          "id": "vschat.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "vschat.login",
        "title": "VsChat: Login"
      },
      {
        "command": "vschat.configureQQ",
        "title": "VsChat: Configure QQ Bot"
      },
      {
        "command": "vschat.clearHistory",
        "title": "VsChat: Clear Chat History"
      },
      {
        "command": "vschat.disconnect",
        "title": "VsChat: Disconnect"
      },
      {
        "command": "vschat.testPush",
        "title": "VsChat: Test Push Notification"
      },
      {
        "command": "vschat.checkUpdates",
        "title": "VsChat: Check for Updates"
      },
      {
        "command": "vschat.showLogs",
        "title": "VsChat: Show Diagnostic Logs"
      }
    ],
    "configuration": {
      "title": "VsChat",
      "properties": {
        "vschat.channel": {
          "type": "string",
          "enum": [
            "wechat",
            "qq"
          ],
          "enumDescriptions": [
            "Use the WeChat iLink transport.",
            "Use the official QQ Bot API v2 transport."
          ],
          "default": "wechat",
          "description": "Chat transport. Reload VS Code after changing this setting."
        },
        "vschat.proxyUrl": {
          "type": "string",
          "default": "",
          "description": "HTTP proxy URL (e.g., http://proxy.example.com:8080). Leave empty to use system proxy."
        },
        "vschat.fromUserId": {
          "type": "string",
          "default": "",
          "description": "WeChat contact ID to chat with (e.g., o9cq800kum_xxx@im.wechat). Leave empty to auto-detect."
        },
        "vschat.qqUserOpenId": {
          "type": "string",
          "default": "",
          "description": "Optional QQ user OpenID for proactive messages. Leave empty to use the most recent user who messaged the bot."
        },
        "vschat.barkUrl": {
          "type": "string",
          "default": "",
          "description": "Bark push URL for iPhone notifications. Use a base URL like https://api.day.app/YOUR_KEY/ or a template containing {title} and {message}. Leave empty to disable."
        },
        "vschat.logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "debug",
          "description": "Diagnostic log verbosity. Debug includes request timing and connection details but excludes credentials and message content."
        },
        "vschat.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically check GitHub Releases for VsChat updates and prompt to install."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run typecheck && npm run bundle && npm run copy-wasm",
    "bundle": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
    "copy-wasm": "cp node_modules/sql.js/dist/sql-wasm.wasm dist/sql-wasm.wasm 2>/dev/null || true",
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "npm run build",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.2",
    "markdown-it": "^14.0.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.10.3",
    "undici": "^6.19.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0"
  }
}
